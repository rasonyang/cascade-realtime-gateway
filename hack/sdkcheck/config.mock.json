{
  "listen": "127.0.0.1:18080",
  "auth": { "api_key": "{env.REALTIME_API_KEY}" },
  "providers": {
    "asr": { "type": "mock", "options": { "utterances": ["hello there"] } },
    "llm": { "type": "mock", "options": { "tokens": ["Hello", " from", " Cascade.", " How", " can", " I", " help?"] } },
    "tts": { "type": "mock", "options": { "ms_per_rune": 10 } }
  },
  "session_defaults": { "instructions": "You are Cascade." },
  "observability": { "log_level": "info" }
}
